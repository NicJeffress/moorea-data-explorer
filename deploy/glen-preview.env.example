# GLEN private preview: service environment (example; no real values).
#
# bootstrap.sh copies this to /etc/glen/glen-preview.env (owner root, group
# glen, mode 0640) the first time and never overwrites it. Edit that copy on
# the droplet with `sudo nano /etc/glen/glen-preview.env`, then
# `systemctl restart glen-preview`. Never commit a filled-in copy.
#
# Format: systemd EnvironmentFile. One KEY=value per line, no `export`, no
# spaces around `=`, no quotes needed. Lines starting with # are ignored.
# Explanations come from docs/preview-operations.md.

# --- Required ---------------------------------------------------------------

# Absolute path of the assembled release folder (the one holding
# release-manifest.json and web/), made by scripts/build_preview_release.py and
# copied to the droplet. The app verifies every file's hash at start-up.
# Example: /srv/glen/releases/preview-rc-2026-11-18
GLEN_PREVIEW_RELEASE=

# Absolute private directory for usage.sqlite3 (the analyst spending ledger)
# and the STOP_ANALYST marker. It must be outside every release and survive
# restarts and rollbacks. glen-preview.service can only write under
# /var/lib/glen, so keep this value.
GLEN_PREVIEW_STATE=/var/lib/glen/state

# The exact public address, https:// plus the hostname, no trailing slash. It
# must match the Tunnel's public hostname and the Access application.
# Example: https://glen.example.com
GLEN_PREVIEW_ORIGIN=

# The Cloudflare Access issuer: your Zero Trust team domain, exactly
# https://<team-name>.cloudflareaccess.com (Zero Trust > Settings > Team name
# and domain). No trailing slash.
GLEN_ACCESS_ISSUER=

# The Access application's audience: the "Application Audience (AUD) Tag" on
# the GLEN Access application's overview page (a long hex string).
GLEN_ACCESS_AUD=

# Comma-separated invited addresses, no spaces. Must list the same people as
# the Access allow policy: the invited testers and the maintainers. Anyone Access lets
# in who is not listed here is still refused by the app.
GLEN_PREVIEW_EMAILS=

# --- Analyst spending -------------------------------------------------------

# Operator monthly budget for the analyst, in millionths of a US dollar per
# UTC month (25000000 = $25). 0, the default, pauses the analyst: charts still
# work, and no model call is made. Change it only after Nic approves an amount.
GLEN_PREVIEW_BUDGET_MICRO_USD=0

# Per-tester ceilings, in millionths of a US dollar. Leave commented out for
# the defaults ($1 per UTC day, $2 per UTC month). These are ceilings, not
# permission to spend; the operator budget above still applies.
#GLEN_PREVIEW_TESTER_DAY_MICRO_USD=1000000
#GLEN_PREVIEW_TESTER_MONTH_MICRO_USD=2000000

# Optional: the analyst model, as `model` or `model@effort`, from the analyst
# entries in backend/analyst_models.py. Leave commented out for the default
# (gpt-5.4-mini-2026-03-17@none). See docs/analyst-models.md for which models
# fit the tester allowances. Do not also set GLEN_ANALYST_EFFORT or the older
# OPENAI_MODEL.
#GLEN_ANALYST_MODEL=gpt-5.4-mini-2026-03-17@none

# --- Provider keys (Nic enters these himself) -------------------------------

# A separate OpenAI project key for the preview, with its own project spend
# limit. Needed only when the analyst model is an OpenAI model and the budget
# above is more than 0. Never shown in pages or copied into web files.
OPENAI_API_KEY=

# Needed instead of the OpenAI key only if GLEN_ANALYST_MODEL is a Claude model.
ANTHROPIC_API_KEY=
